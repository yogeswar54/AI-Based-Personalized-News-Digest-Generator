MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=personalized_news_digest
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_URL=http://localhost:5173
SECRET_KEY=replace-with-a-long-random-value-before-authentication
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
COOKIE_NAME=news_digest_session
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
AI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
NEWS_API_KEY=
NEWS_API_BASE_URL=https://newsapi.org/v2
NEWS_API_DEFAULT_LANGUAGE=en
NEWS_API_DEFAULT_COUNTRY=us
NEWS_COLLECTION_INTERVAL_MINUTES=30
NEWS_COLLECTION_PAGE_SIZE=20
NEWS_PREPROCESSING_INTERVAL_MINUTES=10
NEWS_PREPROCESSING_BATCH_SIZE=25
NEWS_SUMMARIZATION_ENABLED=false
NEWS_SUMMARIZATION_INTERVAL_MINUTES=60
NEWS_SUMMARIZATION_BATCH_SIZE=10
NEWS_SUMMARIZATION_MAX_INPUT_CHARS=30000

# Stage 6 semantic duplicate detection (model downloads on first use)
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
NEWS_DUPLICATE_THRESHOLD=0.85
NEWS_SIMILARITY_THRESHOLD=0.75
NEWS_SIMILARITY_LOOKBACK_DAYS=7
NEWS_SIMILARITY_CANDIDATE_LIMIT=100
NEWS_DEDUPLICATION_ENABLED=false
NEWS_DEDUPLICATION_INTERVAL_MINUTES=15
NEWS_DEDUPLICATION_BATCH_SIZE=25
NEWS_EMBEDDING_BATCH_SIZE=16

# Stage 7 personalization and daily digest scheduling
RECOMMENDATION_CATEGORY_WEIGHT=0.60
RECOMMENDATION_KEYWORD_WEIGHT=0.15
RECOMMENDATION_RECENCY_WEIGHT=0.15
RECOMMENDATION_CONTENT_WEIGHT=0.10
RECOMMENDATION_LOOKBACK_DAYS=30
RECOMMENDATION_CANDIDATE_LIMIT=500
RECOMMENDATION_DIVERSITY_TOLERANCE=0.12
DIGEST_REPEAT_EXCLUSION_DAYS=2
DIGEST_SCHEDULER_ENABLED=false
DIGEST_SCHEDULER_INTERVAL_MINUTES=5
DIGEST_SCHEDULER_BATCH_SIZE=100
DIGEST_GENERATION_LEASE_MINUTES=15
RSS_FEED_URLS=https://feeds.bbci.co.uk/news/rss.xml,https://www.reddit.com/r/worldnews/.rss
ADMIN_SECRET_KEY=replace-with-a-different-long-random-value
